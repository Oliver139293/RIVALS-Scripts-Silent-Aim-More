task.spawn(function()
    while task.wait() do
        local localChar = LocalPlayer.Character
        local hrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        
        -- Process Real Online Opponents Loop
        if _G.HitboxActive then
            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer or not player.Character then continue end
                
                -- Anti-Team Check
                if _G.TeamCheck and player.Team == LocalPlayer.Team and player.Team ~= nil then
                    local hitboxFolder = player.Character:FindFirstChild("Hitbox")
                    local head = hitboxFolder and hitboxFolder:FindFirstChild("Hitbox_Head")
                    if head and head.Size ~= Vector3.new(2,1,1) then 
                        head.Size = Vector3.new(2,1,1) 
                    end
                    continue
                end
                
                local hitboxFolder = player.Character:FindFirstChild("Hitbox")
                local head = hitboxFolder and hitboxFolder:FindFirstChild("Hitbox_Head")
                if head and head:IsA("BasePart") then
                    local dist = (head.Position - hrp.Position).Magnitude
                    local dynamicScale = math.clamp((dist - 5) * 2, 1, _G.HitboxSize)
                    local targetMatrixSize = Vector3.new(dynamicScale, dynamicScale, dynamicScale)
                    if head.Size ~= targetMatrixSize then
                        head.Size = targetMatrixSize
                        head.CanCollide = false
                        head.Massless = true
                    end
                end
            end
        end
        
        -- Process AI Bots Loop
        if _G.HitboxActive and _G.BotCheck then
            for _, bot in ipairs(Workspace:GetChildren()) do
                if bot:IsA("Model") and bot.Name ~= "Map" and bot ~= localChar and not Players:GetPlayerFromCharacter(bot) then
                    local hitboxFolder = bot:FindFirstChild("Hitbox")
                    local head = hitboxFolder and hitboxFolder:FindFirstChild("Hitbox_Head")
                    if head and head:IsA("BasePart") then
                        local dist = (head.Position - hrp.Position).Magnitude
                        local dynamicScale = math.clamp((dist - 3) * 2, 1, _G.HitboxSize)
                        local targetMatrixSize = Vector3.new(dynamicScale, dynamicScale, dynamicScale)
                        if head.Size ~= targetMatrixSize then
                            head.Size = targetMatrixSize
                            head.CanCollide = false
                            head.Massless = true
                        end
                    end
                end
            end
        end
    end
end)

