local function SetupPlayerESP(player)
    if player == LocalPlayer then
        return
    end

    local function ApplyESP(character)
        if Settings.PlayerESP then
            local highlight = character:FindFirstChild("PlayerESP")

            if not highlight then
                highlight = Instance.new("Highlight")
                highlight.Name = "PlayerESP"
                highlight.Adornee = character
                highlight.FillColor = Color3.fromRGB(255,0,0)
                highlight.OutlineColor = Color3.new(1,1,1)
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Parent = character
            end
        end
    end

    if player.Character then
        ApplyESP(player.Character)
    end

    player.CharacterAdded:Connect(function(character)
        character:WaitForChild("HumanoidRootPart")
        task.wait(0.2)
        ApplyESP(character)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    SetupPlayerESP(player)
end

Players.PlayerAdded:Connect(function(player)
    SetupPlayerESP(player)
end)

local function UpdateBotESP()
    for _, bot in ipairs(workspace:GetChildren()) do
        if bot:IsA("Model")
        and BotNames[bot.Name] then

            local highlight = bot:FindFirstChild("BotESP")

            if Settings.BotESP then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "BotESP"
                    highlight.Adornee = bot
                    highlight.FillColor = Color3.fromRGB(255, 255, 0)
                    highlight.OutlineColor = Color3.new(1, 1, 1)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = bot
                end
            elseif highlight then
                highlight:Destroy()
            end
        end
    end
end

local function UpdatePlayerTracers()
    local ActivePlayers = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            ActivePlayers[player] = true

            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if root then

                if not PlayerTracers[player] then
                    local line = Drawing.new("Line")
                    line.Thickness = 1
                    line.Color = Color3.fromRGB(255, 0, 0)
                    line.Visible = false
                    PlayerTracers[player] = line
                end

                local line = PlayerTracers[player]

                if Settings.PlayerTracers then
                    local pos, visible = Camera:WorldToViewportPoint(root.Position)

                    if visible then
                        line.Visible = true
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X, pos.Y)
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end

            elseif PlayerTracers[player] then
                PlayerTracers[player]:Remove()
                PlayerTracers[player] = nil
            end
        end
    end

    -- Remove tracers from players who left
    for player, line in pairs(PlayerTracers) do
        if not ActivePlayers[player] then
            line:Remove()
            PlayerTracers[player] = nil
        end
    end
end

Players.PlayerRemoving:Connect(function(player)
    if PlayerTracers[player] then
        PlayerTracers[player]:Remove()
        PlayerTracers[player] = nil
    end
end)

local function UpdateBotTracers()
    local ActiveBots = {}

    for _, bot in ipairs(workspace:GetChildren()) do
        if bot:IsA("Model") and BotNames[bot.Name] then
            ActiveBots[bot] = true

            local root = bot:FindFirstChild("HumanoidRootPart")

            if root then
                if not BotTracers[bot] then
                    local line = Drawing.new("Line")
                    line.Thickness = 1
                    line.Color = Color3.fromRGB(255,255,0)
                    line.Visible = false
                    BotTracers[bot] = line
                end

                local line = BotTracers[bot]

                if Settings.BotTracers then
                    local pos, visible = Camera:WorldToViewportPoint(root.Position)

                    if visible then
                        line.Visible = true
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X, pos.Y)
                    else
                        line.Visible = false
                    end
                else
                    line.Visible = false
                end
            end
        end
    end

    -- Remove tracers for deleted bots
    for bot, line in pairs(BotTracers) do
        if not ActiveBots[bot] then
            line:Remove()
            BotTracers[bot] = nil
        end
    end
end

